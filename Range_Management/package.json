{
  "name": "shooting-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared-types"
  ],
  "scripts": {
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:web": "cd apps/web && npm run dev",
    "dev:vision": "node -e \"const fs=require('fs'),path=require('path'),{execFileSync}=require('child_process');const cwd=fs.existsSync('apps/vision/main.py')?'apps/vision':'../Shooter_App/apps/vision';const p=['venv/Scripts/python.exe','.venv-linux/bin/python','.venv/bin/python'].map(f=>path.join(cwd,f)).find(f=>fs.existsSync(f))||'python';execFileSync(p,['-m','uvicorn','main:app','--host','0.0.0.0','--port','8000'],{cwd,stdio:'inherit'});\"",
    "build:shared": "cd packages/shared-types && npm run build",
    "build:api": "npm run build:shared && cd apps/api && npm run build",
    "build:web": "npm run build:shared && cd apps/web && npm run build",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:push": "cd apps/api && npx prisma db push",
    "db:seed": "cd apps/api && npx prisma db seed",
    "db:studio": "cd apps/api && npx prisma studio",
    "install:all": "npm install"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
