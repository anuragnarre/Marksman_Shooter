// apps/api/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SHOOTER
  COACH
  RANGE_OPERATOR
}

enum DeviceType {
  CUSTOM_SENSOR
  HEALTH_CONNECT
  MANUAL
}

enum ConnectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         Role
  createdAt    DateTime @default(now())

  isGuest          Boolean        @default(false)
  managedByRangeId String?
  managedByRange   ShootingRange? @relation("RangeManagedGuests", fields: [managedByRangeId], references: [id])

  sessions                  Session[]                      @relation("ShooterSessions")
  coachConnections          CoachConnection[]              @relation("ShooterConnections")
  coachOf                   CoachConnection[]              @relation("CoachConnections")
  feedbacks                 CoachFeedback[]
  coachEvents               TrainingEvent[]                @relation("CoachEvents")
  shooterEvents             EventAssignee[]                @relation("ShooterEvents")
  scheduleRequestsAsShooter ScheduleRequest[]              @relation("ShooterRequests")
  scheduleRequestsAsCoach   ScheduleRequest[]              @relation("CoachRequests")
  trainingPlans             TrainingPlan[]
  shooterProfile            ShooterProfile?                @relation("UserShooterProfile")
  managedShooterProfiles    ShooterProfile[]               @relation("ManagedShooterProfiles")
  devices                   DeviceRegistration[]
  biometricReadings         BiometricReading[]             @relation("UserBiometricReadings")
  competitionRegistrations  CompetitionEventRegistration[]
  createdCompetitionEvents  CompetitionEvent[]             @relation("EventCreator")
  equipment                 Equipment[]
  rangeLocations            RangeLocation[]
  ballisticProfiles         BallisticProfile[]

  ownedRanges  ShootingRange[] @relation("RangeOwner")
  laneBookings LaneBooking[]   @relation("UserBookings")
}

model Session {
  id            String    @id @default(uuid())
  shooterId     String
  discipline    String
  distance      Int
  weaponType    String
  numberOfShots Int
  sessionDate   DateTime
  trainingMode  String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  shooter           User               @relation("ShooterSessions", fields: [shooterId], references: [id])
  shots             Shot[]
  feedback          CoachFeedback[]
  sessionContext    SessionContext?
  biometricReadings BiometricReading[] @relation("SessionBiometricReadings")
  activeInLane      RangeLane?         @relation("LaneActiveSession")

  @@index([shooterId])
}

model Shot {
  id         String   @id @default(uuid())
  sessionId  String
  shotNumber Int
  score      Float
  x          Float
  y          Float
  timestamp  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model CoachConnection {
  id          String           @id @default(uuid())
  shooterId   String
  coachId     String
  status      ConnectionStatus @default(PENDING)
  initiatedBy String           @default("SHOOTER") // 'SHOOTER' | 'COACH'
  createdAt   DateTime         @default(now())

  shooter User @relation("ShooterConnections", fields: [shooterId], references: [id])
  coach   User @relation("CoachConnections", fields: [coachId], references: [id])

  @@index([shooterId])
  @@index([coachId])
}

model CoachFeedback {
  id        String   @id @default(uuid())
  coachId   String
  sessionId String
  feedback  String
  createdAt DateTime @default(now())

  coach   User    @relation(fields: [coachId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([coachId])
  @@index([sessionId])
}

enum EventType {
  SESSION
  TASK
  PLAN
  REMINDER
  COMPETITION
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model TrainingEvent {
  id               String            @id @default(uuid())
  title            String
  description      String?
  eventType        EventType         @default(SESSION)
  start            DateTime
  end              DateTime
  allDay           Boolean           @default(false)
  color            String?
  recurringGroupId String?
  coachId          String
  coach            User              @relation("CoachEvents", fields: [coachId], references: [id])
  assignees        EventAssignee[]
  scheduleRequests ScheduleRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([coachId])
  @@index([recurringGroupId])
}

model EventAssignee {
  id        String        @id @default(uuid())
  eventId   String
  event     TrainingEvent @relation(fields: [eventId], references: [id])
  shooterId String
  shooter   User          @relation("ShooterEvents", fields: [shooterId], references: [id])
  status    String        @default("PENDING")

  @@unique([eventId, shooterId])
  @@index([eventId])
  @@index([shooterId])
}

model SessionContext {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  session         Session  @relation(fields: [sessionId], references: [id])
  heartRate       Int?
  perceivedEffort Int?
  windCondition   String?
  temperature     Float?
  notes           String?
  createdAt       DateTime @default(now())
}

model TrainingPlan {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  content     Json
  weekStart   DateTime
  generatedAt DateTime @default(now())
  focusAreas  String[]
}

model ScheduleRequest {
  id             String        @id @default(uuid())
  eventId        String
  event          TrainingEvent @relation(fields: [eventId], references: [id])
  shooterId      String
  shooter        User          @relation("ShooterRequests", fields: [shooterId], references: [id])
  coachId        String
  coach          User          @relation("CoachRequests", fields: [coachId], references: [id])
  status         RequestStatus @default(PENDING)
  suggestedStart DateTime?
  suggestedEnd   DateTime?
  suggestedTitle String?
  notes          String?
  coachNote      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  resolvedAt     DateTime?

  @@index([eventId])
  @@index([shooterId])
  @@index([coachId])
  @@index([status])
}

model ShooterProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation("UserShooterProfile", fields: [userId], references: [id])
  shooterCode      String   @unique
  primaryWeapon    String?
  managedByCoachId String?
  managedByCoach   User?    @relation("ManagedShooterProfiles", fields: [managedByCoachId], references: [id])
  isManaged        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([managedByCoachId])
}

model DeviceRegistration {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  deviceName String
  deviceType DeviceType
  apiKey     String     @unique
  lastSeenAt DateTime?
  isActive   Boolean    @default(true)
  metadata   Json?
  createdAt  DateTime   @default(now())

  readings     BiometricReading[]
  assignedLane RangeLane?

  @@index([userId])
  @@index([apiKey])
}

model BiometricReading {
  id              String             @id @default(uuid())
  deviceId        String
  device          DeviceRegistration @relation(fields: [deviceId], references: [id])
  userId          String
  user            User               @relation("UserBiometricReadings", fields: [userId], references: [id])
  sessionId       String?
  session         Session?           @relation("SessionBiometricReadings", fields: [sessionId], references: [id])
  timestamp       DateTime           @default(now())
  receivedAt      DateTime           @default(now())
  heartRate       Int?
  spo2            Int?
  respiratoryRate Float?
  stressLevel     Float?
  steps           Int?
  calories        Float?
  activeMinutes   Float?
  readingType     String             @default("continuous")
  confidence      Float?

  @@index([userId, timestamp])
  @@index([sessionId, timestamp])
  @@index([deviceId, timestamp])
}

// ── Competition Events ──────────────────────────────────────────────────────

enum CompetitionEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMING_SOON
}

model CompetitionEvent {
  id              String                         @id @default(uuid())
  name            String
  description     String?
  date            DateTime
  time            String
  location        String
  registrationFee Float?
  rules           String?
  guidelines      String?
  images          String[]
  videos          String[]
  status          CompetitionEventStatus         @default(DRAFT)
  maxParticipants Int?
  createdById     String
  createdBy       User                           @relation("EventCreator", fields: [createdById], references: [id])
  categories      CompetitionEventCategory[]
  registrations   CompetitionEventRegistration[]
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([status])
  @@index([date])
}

model CompetitionEventCategory {
  id              String                         @id @default(uuid())
  eventId         String
  event           CompetitionEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  fee             Float?
  maxParticipants Int?
  registrations   CompetitionEventRegistration[]
}

model CompetitionEventRegistration {
  id            String                    @id @default(uuid())
  eventId       String
  event         CompetitionEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User                      @relation(fields: [userId], references: [id])
  categoryId    String?
  category      CompetitionEventCategory? @relation(fields: [categoryId], references: [id])
  paymentStatus PaymentStatus             @default(COMING_SOON)
  registeredAt  DateTime                  @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ── New Entities (Equipment, Ranges, Ballistics) ───────────────────────────

model Equipment {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  type          String // 'FIREARM' | 'OPTIC' | 'AMMO'
  caliber       String?
  status        String    @default("Active")
  roundCount    Int       @default(0)
  regPressure   String?
  lastCleaned   DateTime?
  nextService   Int?
  barrelLifePct Int?      @default(100)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model RangeLocation {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  status           String   @default("Active")
  maxDistance      Int?
  altitude         Int?
  gpsCoordinates   String?
  typicalWindDir   String?
  maxCaliber       String?
  environmentalLog Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model BallisticProfile {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String?
  muzzleVelocityFps  Int
  pelletWeightGrains Float
  ballisticCoef      Float
  sightHeightInches  Float
  zeroRangeYards     Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

// ── Range Operations (V2) ──────────────────────────────────────────────────

model ShootingRange {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique // 6-character code for easy join
  ownerId   String
  owner     User     @relation("RangeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lanes         RangeLane[]
  bookings      LaneBooking[]
  managedGuests User[]        @relation("RangeManagedGuests")

  @@index([ownerId])
  @@index([code])
}

model RangeLane {
  id              String              @id @default(uuid())
  rangeId         String
  range           ShootingRange       @relation(fields: [rangeId], references: [id], onDelete: Cascade)
  laneNumber      Int
  name            String? // e.g. "Lane 1 - 10m"
  deviceId        String?             @unique // Link to a camera/sensor
  device          DeviceRegistration? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  activeSessionId String?             @unique // Link to an active session
  activeSession   Session?            @relation("LaneActiveSession", fields: [activeSessionId], references: [id], onDelete: SetNull)
  status          String              @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  bookings LaneBooking[]

  @@unique([rangeId, laneNumber])
}

model LaneBooking {
  id            String        @id @default(uuid())
  rangeId       String
  range         ShootingRange @relation(fields: [rangeId], references: [id], onDelete: Cascade)
  laneId        String?
  lane          RangeLane?    @relation(fields: [laneId], references: [id], onDelete: SetNull)
  userId        String
  user          User          @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)
  startTime     DateTime
  endTime       DateTime
  amount        Float         @default(0)
  paymentStatus String        @default("PENDING") // PENDING, PAID, CANCELLED
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([rangeId, startTime])
  @@index([userId])
}
