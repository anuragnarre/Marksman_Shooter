# Production environment variables — set these in Railway's Variables dashboard
# These are NOT committed with real values — just documentation of required keys

# ── Web service (Next.js) ───────────────────────────────────────────────────────
# URL of the deployed API service
NEXT_PUBLIC_API_URL=https://YOUR-API-SERVICE.up.railway.app

# Same as above (WebSocket uses same origin)
NEXT_PUBLIC_WS_URL=https://YOUR-API-SERVICE.up.railway.app

# ── API service (NestJS) ────────────────────────────────────────────────────────
# PostgreSQL connection string (from Railway database service)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# Strong random secret for JWT signing (generate with: openssl rand -base64 32)
JWT_SECRET=your-strong-random-secret-here
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (NO trailing slashes)
CORS_ORIGINS=https://www.marksmanspro.com,https://marksmanspro.com

# Port Railway assigns automatically — leave as-is
PORT=3001

# ── APK delivery ───────────────────────────────────────────────────────────────
# Server-only var keeps the URL out of HTML source (preferred for production)
# Set to CDN URL or GitHub Releases URL for the latest APK
APK_URL=https://cdn.marksmanspro.com/releases/marksman-latest.apk
# Fallback public var (only if APK_URL is not set)
# NEXT_PUBLIC_APK_URL=https://cdn.marksmanspro.com/releases/marksman-latest.apk

# ── Build command (Railway → API service → Settings → Build) ───────────────────
# npm run build
# (runs: prisma generate && nest build)

# ── Start command (Railway → API service → Settings → Deploy) ──────────────────
# npm run start:prod
# (runs: prisma migrate deploy && node dist/main)
