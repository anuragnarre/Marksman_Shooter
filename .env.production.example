# ── Production Environment Template ───────────────────────────────────────
# Copy this file to .env.prod and populate with your production secrets.

# Domain configuration
ROOT_DOMAIN=yourdomain.com
NEXT_PUBLIC_SHOOTER_URL=https://app.yourdomain.com
NEXT_PUBLIC_RANGE_URL=https://range.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=https://api.yourdomain.com
NEXT_PUBLIC_RANGE_API_URL=https://range-api.yourdomain.com
NEXT_PUBLIC_RANGE_WS_URL=https://range-api.yourdomain.com

# PostgreSQL Credentials
POSTGRES_USER=marksman_admin
POSTGRES_PASSWORD=generate_a_strong_password_here_32chars!
POSTGRES_DB=shooting_platform

# Authentication Secret
JWT_SECRET=generate_a_cryptographically_secure_jwt_secret_here!

# Cloudflare Tunnel Token (Generated in Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...your_tunnel_token_from_cloudflare_zero_trust...

