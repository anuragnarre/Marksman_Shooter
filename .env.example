# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/shooting_platform"

# ── Authentication ────────────────────────────────────────────────────────────
# Secret key for signing JWTs — use a long random string in production
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
# Token expiry (e.g. 7d, 24h, 3600s)
JWT_EXPIRES_IN="7d"

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated allowed CORS origins for the API
CORS_ORIGINS="http://localhost:3000"

# ── Vision Microservice ───────────────────────────────────────────────────────
# Base URL where the FastAPI vision service is running
VISION_SERVICE_URL="http://localhost:8000"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Web OAuth Client ID — used by API to verify Google ID tokens, and by the
# web frontend GSI button. Must match capacitor.config.ts serverClientId.
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Public API base URL consumed by the Next.js app
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Public WebSocket URL for real-time updates
NEXT_PUBLIC_WS_URL="http://localhost:3001"
# Must match GOOGLE_CLIENT_ID above
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
